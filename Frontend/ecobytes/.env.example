# ─────────────────────────────────────────────────────────────
# EcoBytes — Variables de build para el servicio "web"
# (docker-compose.yml / docker-compose.frontend.yml, ambos en la
# raíz del repo)
# ─────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env  (dentro de esta carpeta)
#   2. Rellena el valor real en .env
#   3. NUNCA subas .env al repositorio (ya está en .gitignore)
#   4. Al invocar docker compose desde la raíz del repo, pasa la ruta
#      explícita con --env-file, porque este archivo ya no está en el
#      mismo directorio que los .yml:
#        docker compose --env-file Frontend/ecobytes/.env up
#        docker compose --env-file Frontend/ecobytes/.env -f docker-compose.frontend.yml up
#
# No confundir con Backend/.env — ese tiene las credenciales de
# ClickHouse y CORS_ORIGINS del backend; este solo alimenta el
# build del servicio `web`.
# ─────────────────────────────────────────────────────────────

# ── Frontend (servicio "web") ──────────────────────────────
# URL donde el NAVEGADOR DEL CLIENTE (no el contenedor) puede
# alcanzar al backend. Queda compilada dentro del bundle JS en
# build time (--dart-define), no es una variable de runtime.
#
# - Mismo equipo (desarrollo local): http://localhost:8000
# - Servidor remoto en tu red local: http://<IP-DEL-SERVIDOR>:8000
#
# Debe coincidir exactamente (protocolo + host + puerto) con el
# origen que registres en CORS_ORIGINS dentro de Backend/.env.
API_BASE_URL=http://localhost:8000
