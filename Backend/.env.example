# ─────────────────────────────────────────────────────────────
# EcoBytes — Variables de Entorno
# ─────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores reales en .env
#   3. NUNCA subas .env al repositorio (ya está en .gitignore)
# ─────────────────────────────────────────────────────────────

# ── Base de datos ──────────────────────────────────────────
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_bd
# En Docker, el host es el nombre del servicio: "db"
DATABASE_URL=postgresql+asyncpg://ecobytes_user:ecobytes_pass@db:5432/ecobytes

# ── Autenticación JWT ──────────────────────────────────────
# Genera una clave segura con: openssl rand -hex 32
JWT_SECRET_KEY=cambia_esto_por_una_clave_secreta_larga_y_aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440   # 24 horas

# ── Proveedor de IA para el chatbot ────────────────────────
# Opciones: "anthropic" o "openai"
LLM_PROVIDER=anthropic

# Clave de Anthropic (si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Clave de OpenAI (si LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# ── Entorno ────────────────────────────────────────────────
# "development" o "production"
ENVIRONMENT=development
