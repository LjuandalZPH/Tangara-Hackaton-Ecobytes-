# ── ClickHouse (capa Plata del pipeline Tángara, solo lectura) ──
CLICKHOUSE_HOST=clickhouse.sebaxtian.dev
CLICKHOUSE_PORT=443
CLICKHOUSE_USER=cambia_esto_por_tu_usuario
CLICKHOUSE_PASSWORD=cambia_esto_por_tu_contraseña
CLICKHOUSE_DATABASE=tangara_plata
CLICKHOUSE_SECURE=True
