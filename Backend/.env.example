# ─────────────────────────────────────────────────────────────
# EcoBytes — Variables de Entorno
# ─────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores reales en .env
#   3. NUNCA subas .env al repositorio (ya está en .gitignore)
# ─────────────────────────────────────────────────────────────

# ── ClickHouse (capa Plata del pipeline Tángara, solo lectura) ──
# El backend nunca escribe en tangara_plata, tangara_bronce ni
# tangara_gold. La ingesta es responsabilidad del pipeline de
# Tángara, fuera de este repo.
CLICKHOUSE_HOST=clickhouse.sebaxtian.dev
CLICKHOUSE_PORT=443
CLICKHOUSE_USER=cambia_esto_por_tu_usuario
CLICKHOUSE_PASSWORD=cambia_esto_por_tu_contraseña
CLICKHOUSE_DATABASE=tangara_plata
CLICKHOUSE_SECURE=True

# ── CORS ────────────────────────────────────────────────────
# Dominio(s) donde corre el frontend Flutter (web). Separa varios
# orígenes con comas si hace falta. Ajusta el puerto al de tu
# entorno de desarrollo de Flutter (ej. http://localhost:PUERTO_FLUTTER_DEV).
#
# OBLIGATORIO: el default en config.py es vacío (fail-closed, ver
# docs/backend.md). Si no defines esto, el navegador bloqueará todas las
# llamadas del frontend.
CORS_ORIGINS=http://localhost:PUERTO_FLUTTER_DEV

# ── Chatbot (OpenAI) ────────────────────────────────────────
# Alimenta POST /chatbot (el asistente ambiental del frontend).
# Si OPENAI_API_KEY queda vacía, ese endpoint responde 503 con un
# mensaje claro y TODO lo demás de la API sigue funcionando igual:
# el chatbot es opcional, no un requisito para levantar el servicio.
OPENAI_API_KEY=
# Modelo a usar. gpt-4o-mini es el default por costo/latencia; el
# chatbot no razona, solo redacta sobre datos ya calculados.
OPENAI_MODEL=gpt-4o-mini
# Timeout de la llamada al modelo, en segundos.
OPENAI_TIMEOUT_SEGUNDOS=30

# ── Entorno ────────────────────────────────────────────────
# "development" o "production"
ENVIRONMENT=development
