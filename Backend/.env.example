# ─────────────────────────────────────────────────────────────
# EcoBytes — Variables de Entorno
# ─────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores reales en .env
#   3. NUNCA subas .env al repositorio (ya está en .gitignore)
# ─────────────────────────────────────────────────────────────

# ── Base de datos ──────────────────────────────────────────
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_bd
# En Docker, el host es el nombre del servicio: "db"
DATABASE_URL=postgresql+asyncpg://ecobytes_user:ecobytes_pass@db:5432/ecobytes

# ── Entorno ────────────────────────────────────────────────
# "development" o "production"
ENVIRONMENT=development
